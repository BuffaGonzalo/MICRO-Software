  }
  QPushButton#pushButton_blockAutoData:checked, QPushButton#pushButton_blockAutoData_comm:checked {
      background-color: #3b111a;
      color: #ff4d6d;
      border: 1.5px solid #ff4d6d;
  }

  QPushButton#pushButton_sendCommand {
      background-color: #1a2736;
      color: #00f2c3;
      border: 1.5px solid #00f2c3;
      border-radius: 6px;
      padding: 6px;
      font-weight: bold;
      font-size: 9.5pt;
  }
  QPushButton#pushButton_sendCommand:hover {
