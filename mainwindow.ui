  <property name="styleSheet">
   <string notr="true">
QMainWindow, QDialog, QWidget#centralwidget, QWidget#MAIN, QWidget#GRAF, QWidget#TELE, QStackedWidget {
    background-color: #1e1e2d;
    color: #e2e2e2;
}

QPushButton {
    background-color: #27293d;
    color: #00f2c3;
    border: 1px solid #e14eca;
    border-radius: 6px;
    padding: 6px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #e14eca;
    color: white;
}

QLineEdit, QSpinBox, QComboBox, QTextBrowser {
    background-color: #1d1e2b;
    color: #00f2c3;
    border: 1px solid #27293d;
    border-radius: 4px;
    padding: 3px;
}

QLabel {
    color: #e2e2e2;
    font-weight: bold;
}

QGroupBox {
    border: 1px solid #27293d;
    margin-top: 10px;
    color: #e14eca;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 3px;
}

QLCDNumber {
    color: #00f2c3;
    background-color: #1d1e2b;
    border: 1px solid #27293d;
}

QCheckBox {
    color: #e2e2e2;
}
/* Boxes para Telemetria y Sensores/Modo Esquivado en Main, 3D, Graficas y Comandos */
QFrame#box_linea, QFrame#box_balance, QFrame#box_motores, QFrame#box_esquivar, QFrame#box_sensors, QFrame#box_dodgeDir, QFrame#box_3d_container, QFrame#box_chart_orientation, QFrame#box_chart_balance, QFrame#box_chart_line, QFrame#box_manual_commands {
    background-color: #151522;
    border-top: 1px solid #2d2f44;
    border-left: 1px solid #2d2f44;
    border-bottom: 1px solid #0e0e16;
    border-right: 1px solid #0e0e16;
    border-radius: 8px;
}

/* Bisel prominente para el contenedor del viewport 3D */
QFrame#frame_3d_viewport {
    background-color: #101018;
    border-top: 2px solid #3d405b;
    border-left: 2px solid #3d405b;
    border-bottom: 2px solid #080810;
    border-right: 2px solid #080810;
    border-radius: 6px;
}

/* Cajas individuales para cada item modificador */
QFrame#item_line_kp, QFrame#item_line_kd, QFrame#item_attack_sp, QFrame#item_custom_turn,
QFrame#item_kp_cascada, QFrame#item_ki_cascada, QFrame#item_filter_lpf,
QFrame#item_bal_kp, QFrame#item_bal_kd, QFrame#item_bal_ki, QFrame#item_bal_sp,
QFrame#item_vel_div, QFrame#item_vel_lim, QFrame#item_turn_lim,
QFrame#item_pwm_min_l, QFrame#item_pwm_min_r, QFrame#item_pwm_l, QFrame#item_pwm_r,
QFrame#item_off_l, QFrame#item_off_r, QFrame#item_pwm_lrot, QFrame#item_pwm_rrot,
QFrame#item_static_off, QFrame#item_moving_off, QFrame#item_limit_angle,
QFrame#item_front_dist, QFrame#item_side_dist, QFrame#item_lost_dist, QFrame#item_stop_cycles,
QFrame#item_align_dist, QFrame#item_corner_dist, QFrame#item_wall_kp, QFrame#item_wall_kd,
QFrame#item_front_kp, QFrame#item_front_kd {
    background-color: #101018;
    border-top: 1px solid #222334;
    border-left: 1px solid #222334;
    border-bottom: 1px solid #090910;
    border-right: 1px solid #090910;
    border-radius: 6px;
}

/* Titulos destacados de las secciones */
QLabel#label_sensors_10, QLabel#label_sensors_9, QLabel#label_sensors_3, QLabel#label_sensors_4,
QLabel#label_dodgeDir {
    color: #00f2c3;
    font-size: 11pt;
    font-weight: bold;
    padding-bottom: 2px;
}

/* Titulo de sensores compacto (Poco lugar como pidio el usuario) */
QLabel#label_sensors {
    color: #e14eca;
    font-size: 8.5pt;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 0px;
    margin: 0px;
    max-height: 16px;
}

/* Indicador FRENTE DEL AUTO */
QLabel#label_car_front {
    color: #00f2c3;
    font-size: 8pt;
    font-weight: bold;
    letter-spacing: 1.5px;
    padding: 1px 0px;
}

/* Cuadraditos de posicion de sensores en el autito (Obstaculos) */
QLabel#sens_pos_front, QLabel#sens_pos_ir5, QLabel#sens_pos_ir8,
QLabel#sens_pos_ir3, QLabel#sens_pos_ir1 {
    background-color: #1a1a2a;
    border: 1.5px solid #e14eca;
    border-radius: 4px;
    color: #ffffff;
    font-size: 6.5pt;
    font-weight: bold;
    padding: 1px;
}

/* Cuadraditos de posicion de sensores en el autito (Linea) */
QLabel#sens_pos_line_l, QLabel#sens_pos_line_c, QLabel#sens_pos_line_r {
    background-color: #121a22;
    border: 1.5px solid #00f2c3;
    border-radius: 4px;
    color: #00f2c3;
    font-size: 6.5pt;
    font-weight: bold;
    padding: 1px;
}

/* Chasis del autito */
QFrame#frame_car_diagram {
    background-color: #101018;
    border: 1px solid #232536;
    border-radius: 6px;
}

QFrame#frame_chassis {
    background-color: #151624;
    border: 1.5px dashed #3a3d54;
    border-radius: 6px;
}

QLabel#label_chassis_title {
    color: #00f2c3;
    font-size: 6.5pt;
    font-weight: bold;
}

QLabel#label_chassis_footer {
    color: #5d627c;
    font-size: 6pt;
    font-weight: bold;
}

/* Marcos de Lectores de Linea, Obstaculos e IMU */
QFrame#frame_line_readings, QFrame#frame_obstacle_readings, QFrame#frame_imu_readings {
    background-color: #101018;
    border: 1px solid #202232;
    border-radius: 6px;
}

QLabel#label_title_line_readings {
    color: #00f2c3;
    font-size: 7.5pt;
    font-weight: bold;
    letter-spacing: 0.5px;
}

QLabel#label_title_obstacle_readings {
    color: #e14eca;
    font-size: 7.5pt;
    font-weight: bold;
    letter-spacing: 0.5px;
}

QLabel#label_title_imu_readings {
    color: #7982a9;
    font-size: 7pt;
    font-weight: bold;
    letter-spacing: 0.5px;
}

/* Estilos de las etiquetas individuales de los sensores de linea */
QLabel#ir2_label, QLabel#ir4_label, QLabel#ir6_label {
    color: #00f2c3;
    font-size: 7pt;
    font-weight: bold;
    padding-left: 2px;
}

/* Estilos de las etiquetas individuales de los sensores de obstaculos */
QLabel#ir7_label, QLabel#ir5_label, QLabel#ir8_label, QLabel#ir3_label, QLabel#ir1_label {
    color: #e14eca;
    font-size: 7pt;
    font-weight: bold;
    padding-left: 2px;
}

/* LCDs de sensores de linea (Piso) */
QLCDNumber#ir2_data, QLCDNumber#ir4_data, QLCDNumber#ir6_data {
    color: #00f2c3;
    background-color: #121a22;
    border: 1px solid #1e3a38;
    border-radius: 4px;
    min-height: 22px;
}

/* LCDs de Distancia Calculada en cm (Obstaculos) */
QLCDNumber#ir1_cm_data, QLCDNumber#ir3_cm_data, QLCDNumber#ir5_cm_data,
QLCDNumber#ir7_cm_data, QLCDNumber#ir8_cm_data {
    color: #00f2c3;
    background-color: #0b1118;
    border: 1px solid #00f2c3;
    border-radius: 3px;
    min-height: 20px;
    max-height: 22px;
    min-width: 50px;
}

/* LCDs de valor crudo ADC (Obstaculos) */
QLCDNumber#ir7_data, QLCDNumber#ir5_data, QLCDNumber#ir8_data, QLCDNumber#ir3_data, QLCDNumber#ir1_data {
    color: #ff79c6;
    background-color: #17111c;
    border: 1px solid #3d2036;
    border-radius: 3px;
    min-height: 18px;
    max-height: 20px;
    min-width: 46px;
}

/* Etiquetas de sensores de linea */
QLabel#ir2_label, QLabel#ir4_label, QLabel#ir6_label {
    color: #00f2c3;
    font-size: 8pt;
    font-weight: bold;
    padding-left: 2px;
}

/* Etiquetas de sensores de distancia */
QLabel#ir1_label, QLabel#ir3_label, QLabel#ir5_label, QLabel#ir7_label, QLabel#ir8_label {
    color: #ff79c6;
    font-size: 7.5pt;
    font-weight: bold;
    padding-left: 1px;
}

QLabel#ir1_dist_label, QLabel#ir3_dist_label, QLabel#ir5_dist_label, QLabel#ir7_dist_label, QLabel#ir8_dist_label {
    color: #00f2c3;
    font-size: 7.5pt;
    font-weight: bold;
}

QLabel#ir1_cm_unit, QLabel#ir3_cm_unit, QLabel#ir5_cm_unit, QLabel#ir7_cm_unit, QLabel#ir8_cm_unit {
    color: #00f2c3;
    font-size: 8pt;
    font-weight: bold;
}


/* Barras de Distancia de Obstaculos */
QProgressBar#bar_ir1, QProgressBar#bar_ir3, QProgressBar#bar_ir5,
QProgressBar#bar_ir7, QProgressBar#bar_ir8 {
    border: 1px solid #1f2e29;
    border-radius: 3px;
    background-color: #0b1115;
    text-align: center;
    color: #ffffff;
    font-size: 6pt;
    font-weight: bold;
    min-height: 12px;
    max-height: 14px;
}

QProgressBar#bar_ir1::chunk, QProgressBar#bar_ir3::chunk, QProgressBar#bar_ir5::chunk,
QProgressBar#bar_ir7::chunk, QProgressBar#bar_ir8::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00e676, stop:1 #00f2c3);
    border-radius: 2px;
}

/* Barras de Lectores de Linea */
QProgressBar#bar_ir2, QProgressBar#bar_ir4, QProgressBar#bar_ir6 {
    border: 1px solid #162432;
    border-radius: 3px;
    background-color: #0c1219;
    text-align: center;
    color: #ffffff;
    font-size: 6pt;
    font-weight: bold;
    min-height: 10px;
    max-height: 12px;
}

QProgressBar#bar_ir2::chunk, QProgressBar#bar_ir4::chunk, QProgressBar#bar_ir6::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00b4d8, stop:1 #00f2c3);
    border-radius: 2px;
}

QLabel#ir1_raw_tag, QLabel#ir3_raw_tag, QLabel#ir5_raw_tag, QLabel#ir7_raw_tag, QLabel#ir8_raw_tag {
    color: #72768f;
    font-size: 6.5pt;
}

/* Sensores MPU / ACC / Gyro (Menor Prioridad) */
QLabel#ax_label, QLabel#ay_label, QLabel#az_label,
QLabel#gx_label, QLabel#gy_label, QLabel#gz_label,
QLabel#angle_label, QLabel#turn_offset_label, QLabel#angle_hr_label, QLabel#dt_ms_label {
    color: #6f748b;
    font-size: 7.5pt;
    font-weight: normal;
    padding-left: 1px;
}

QLCDNumber#ax_data, QLCDNumber#ay_data, QLCDNumber#az_data,
QLCDNumber#gx_data, QLCDNumber#gy_data, QLCDNumber#gz_data,
QLCDNumber#angle_data, QLCDNumber#turn_offset_data, QLCDNumber#angle_hr_data, QLCDNumber#dt_ms_data {
    color: #4a7570;
    background-color: #12131d;
    border: 1px solid #1c1e2b;
    border-radius: 3px;
    min-height: 18px;
}




/* Barra de Navegacion Superior (Header) */
QFrame#header_navigation_bar {
    background-color: #13141f;
    border: 1px solid #25283b;
    border-radius: 8px;
    padding: 2px;
}

/* Botones de Pestanas de Navegacion */
QPushButton#btn_nav_infrarrojos, QPushButton#btn_nav_visualizacion,
QPushButton#btn_nav_tuning {
    background-color: #1a1c2b;
    color: #8c93a8;
    border: 1px solid #272a40;
    border-radius: 6px;
    padding: 5px 14px;
    font-size: 8pt;
    font-weight: bold;
    min-height: 22px;
}

QPushButton#btn_nav_infrarrojos:hover, QPushButton#btn_nav_visualizacion:hover,
QPushButton#btn_nav_tuning:hover:hover {
    background-color: #24273d;
    color: #ffffff;
    border-color: #3b3f5c;
}

QPushButton#btn_nav_infrarrojos:checked, QPushButton#btn_nav_visualizacion:checked,
QPushButton#btn_nav_tuning:checked:checked {
    background-color: #1b263b;
    color: #00f2c3;
    border: 1.5px solid #00f2c3;
}

  /* Botones de Modo del Robot (Derecha) */

