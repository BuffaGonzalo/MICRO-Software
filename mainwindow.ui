  }

QTabWidget::pane {
    border: 1px solid #27293d;
    background-color: #151522;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #1e1e2d;
    color: #e2e2e2;
    border: 1px solid #27293d;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 16px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #27293d;
    color: #00f2c3;
    border-color: #e14eca;
}

QTabBar::tab:hover {
    background-color: #25273c;
    color: white;
}

QChartView, QChartView#PIDchart {
    background-color: #151522;
    border: 1px solid #27293d;
    border-radius: 8px;
}

QFrame#box_serial_conn, QFrame#box_udp_conn {
    background-color: #151522;
    border-top: 1px solid #2d2f44;
    border-left: 1px solid #2d2f44;
    border-bottom: 1px solid #0e0e16;
    border-right: 1px solid #0e0e16;
    border-radius: 8px;
}

QMenuBar {
    background-color: #1e1e2d;
    color: #e2e2e2;
    font-weight: bold;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    font-weight: bold;
}
QMenuBar::item:selected {
    background-color: #27293d;
    color: #00f2c3;
    border-radius: 4px;
}
QMenu {
    background-color: #1e1e2d;
    color: #e2e2e2;
    border: 1px solid #27293d;
    font-weight: bold;
}
QMenu::item:selected {
    background-color: #27293d;
    color: #00f2c3;
}
